/* --- General Reset --- */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
}

body {
    background-color: #f4f4f9;
    color: #333;
    padding-top: 70px; /* Space for the fixed nav bar */
}

/* --- 1. MENU STYLES (W3Schools Icon Bar) --- */
.icon-bar {
    width: 100%;
    background-color: #555;
    overflow: auto;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;
}

.icon-bar a {
    float: left;
    width: 20%;
    text-align: center;
    padding: 12px 0;
    transition: all 0.3s ease;
    color: white;
    font-size: 24px;
    text-decoration: none;
}

.icon-bar a:hover {
    background-color: #000;
}

.icon-bar a.active {
    background-color: #04AA6D;
}

/* --- 2. MAIN LAYOUT (CSS GRID) --- */
.grid-container {
    display: grid;
    /* This is the magic line for responsive columns without media queries */
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
    padding: 20px;
    max-width: 1200px;
    margin: 0 auto;
}

.grid-header {
    grid-column: 1 / -1; /* Spans across all columns */
    text-align: center;
    padding: 40px 20px;
    background: white;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.grid-item {
    background: white;
    padding: 25px;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

/* --- 3. INTERNAL LAYOUT (FLEXBOX) --- */
/* Using Flexbox to arrange the image and text side-by-side inside the grid items */
.flex-demo, .grid-demo {
    display: flex;
    flex-wrap: wrap; /* Allows items to wrap on small screens */
    gap: 20px;
    margin-top: 15px;
    align-items: center;
}

.flex-demo img, .grid-demo img {
    border-radius: 8px;
    flex: 1 1 150px; /* Grow, shrink, base width */
}

.text-content {
    flex: 2 1 250px; /* Takes up twice as much space as the image when available */
}

.text-content h3 {
    margin-bottom: 10px;
    color: #2c3e50;
}

.text-content p {
    margin-bottom: 10px;
    line-height: 1.6;
}

.text-content ul {
    padding-left: 20px;
    line-height: 1.6;
    font-size: 0.9em;
}

code {
    background: #eee;
    padding: 2px 5px;
    border-radius: 4px;
    font-family: monospace;
}

/* --- Footer --- */
footer {
    text-align: center;
    padding: 20px;
    margin-top: 40px;
    background-color: #333;
    color: white;
}
